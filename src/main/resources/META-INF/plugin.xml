    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>
    <depends>com.intellij.tasks</depends>
    <actions>
        <action
                id="GitFlowHelper.FeatureStartAction"
                class="br.com.gitflowhelper.actions.FeatureStartAction"
                text="Feature Start"
                description="Creates a new local feature branch (git flow feature start)."
                icon="AllIcons.Toolwindows.ToolWindowRun">
            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="ctrl alt 1"/>
        </action>
        <action
                id="GitFlowHelper.FeaturePublishAction"
                class="br.com.gitflowhelper.actions.FeaturePublishAction"
                text="Feature Publish"
                description="Pushes the current feature branch to VCS (git flow feature publish)."
                icon="AllIcons.CodeWithMe.CwmShared">
            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="ctrl alt 2"/>
        </action>
        <action
                id="GitFlowHelper.FeatureSyncAction"
                class="br.com.gitflowhelper.actions.FeatureSyncAction"
                text="Feature Sync"
                description="Syncs the current feature branch with develop."
                icon="AllIcons.Actions.Refresh">
        </action>
        <action
                id="GitFlowHelper.FeatureFinishAction"
                class="br.com.gitflowhelper.actions.FeatureFinishAction"
                text="Feature Finish"
                description="Merges current feature branch into develop chain and deletes current branch or creates a merge request (git flow feature finish)."
                icon="AllIcons.Vcs.Patch_applied">
            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="ctrl alt 3"/>
        </action>

        <action
                id="GitFlowHelper.ReleaseStartAction"
                class="br.com.gitflowhelper.actions.ReleaseStartAction"
                text="Release Start"
                description="Creates a new local release branch (git flow release start)."
                icon="AllIcons.Toolwindows.ToolWindowRun">
            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="ctrl alt 4"/>
        </action>
        <action
                id="GitFlowHelper.ReleasePublishAction"
                class="br.com.gitflowhelper.actions.ReleasePublishAction"
                text="Release Publish"
                description="Pushes the current release branch to VCS (git flow release publish)."
                icon="AllIcons.CodeWithMe.CwmShared">
            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="ctrl alt 5"/>
        </action>
        <action
                id="GitFlowHelper.ReleaseSyncAction"
                class="br.com.gitflowhelper.actions.ReleaseSyncAction"
                text="Release Sync"
                description="Syncs the current release branch with develop."
                icon="AllIcons.Actions.Refresh">
        </action>
        <action
                id="GitFlowHelper.ReleaseFinishAction"
                class="br.com.gitflowhelper.actions.ReleaseFinishAction"
                text="Release Finish"
                description="Merges current release branch into master chain and deletes current branch (git flow release finish)."
                icon="AllIcons.Vcs.Patch_applied">
            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="ctrl alt 6"/>
        </action>

        <action
                id="GitFlowHelper.HotfixStartAction"
                class="br.com.gitflowhelper.actions.HotfixStartAction"
                text="Hotfix Start"
                description="Creates a new local hotfix branch (git flow hotfix start)."
                icon="/icons/toolWindowRun.svg">
            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="ctrl alt 7"/>
        </action>
        <action
                id="GitFlowHelper.HotfixPublishAction"
                class="br.com.gitflowhelper.actions.HotfixPublishAction"
                text="Hotfix Publish"
                description="Pushes the current hotfix branch to VCS (git flow hotfix publish)."
                icon="AllIcons.CodeWithMe.CwmShared">
            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="ctrl alt 8"/>
        </action>
        <action
                id="GitFlowHelper.HotfixSyncAction"
                class="br.com.gitflowhelper.actions.HotfixSyncAction"
                text="Hotfix Sync"
                description="Syncs the current hotfix branch with main."
                icon="AllIcons.Actions.Refresh">
        </action>
        <action
                id="GitFlowHelper.HotfixFinishAction"
                class="br.com.gitflowhelper.actions.HotfixFinishAction"
                text="Hotfix Finish"
                description="Merges current hotfix branch into master and develop chains and deletes current branch (git flow hotfix finish)."
                icon="AllIcons.Vcs.Patch_applied">
            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="ctrl alt 9"/>
        </action>



    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <statusBarWidgetFactory
                id="GitFlowWidget"
                implementation="br.com.gitflowhelper.statusbar.GitFlowStatusBarWidgetFactory"/>
        <toolWindow
                id="GitFlow"
                anchor="bottom"
                icon="/icons/gitflow_gray.svg"
                factoryClass="br.com.gitflowhelper.toolwindow.GitFlowToolWindowFactory"/>

        <notificationGroup id="GitFlowNotificationGroup"
                           displayType="BALLOON" />

        <checkinHandlerFactory implementation="br.com.gitflowhelper.checkin.GitFlowCheckinHandlerFactory"/>
    </extensions>
</idea-plugin>
